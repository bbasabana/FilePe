{
  "name": "filepe-fingerprint-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Agent local WebSocket pour ZKTeco Live20R (FilePe)",
  "main": "server.cjs",
  "bin": "server.cjs",
  "scripts": {
    "start": "node server.cjs",
    "start:mock": "cross-env FILEPE_FP_MODE=mock node server.cjs",
    "start:hardware": "cross-env FILEPE_FP_MODE=hardware node server.cjs",
    "build:exe": "pkg server.cjs --targets node18-win-x64 --output dist/FilePeFingerprintAgent.exe"
  },
  "pkg": {
    "targets": ["node18-win-x64"],
    "outputPath": "dist"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "pkg": "^5.8.1"
  }
}
